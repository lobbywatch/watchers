FROM python:3.14.9-slim-trixie@sha256:a145a961ec2cf5741772d5e39773d979271132884fd778f6c3fad34e52b85402

RUN apt-get update && apt-get install -y libmariadb-dev-compat gcc && apt-get clean

RUN useradd -u 1000 --create-home --shell /usr/bin/bash bot

ENV PATH=/home/bot/.local/bin:$PATH

USER bot

RUN pip --no-cache-dir install poetry

WORKDIR /opt/app

COPY . .

WORKDIR /opt/app/apps/website-watcher

RUN poetry install --no-root

CMD ["poetry", "run", "fastapi", "run", "src/main.py", "--port", "8000"]
