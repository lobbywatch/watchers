FROM python:3.14.9-slim-trixie@sha256:a145a961ec2cf5741772d5e39773d979271132884fd778f6c3fad34e52b85402

RUN apt-get update && apt-get install -y pkg-config gcc libmariadb-dev-compat

RUN pip install poetry

WORKDIR /opt/app

ADD . . 

WORKDIR /opt/app/apps/hr-watcher

RUN poetry install --no-root

ENTRYPOINT ["poetry", "run", "python", "src/shab-download.py", "--json", "slack"]

